# C03 Marketplace — environment variable names and placeholders only.
# Do not put real secrets in this file.
# At runtime, docker compose reads existing local env files
# (backend/.env and negotiation_agents/.env). Those files are
# excluded from Docker build context and are never copied into images.

# --- backend ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/DATABASE
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
OPENAI_API_KEY=sk-your-openai-key
PYTHON_RAG_SCRIPT=../rag/rag_engine.py
NEGOTIATION_API_URL=http://negotiation:8000

# --- negotiation (do not reuse the RAG OPENAI_API_KEY) ---
OPENAI_NEGOTIATION_API_KEY=
OPENAI_NEGOTIATION_MODEL=
OPENAI_NEGOTIATION_TIMEOUT_SECONDS=120
AGENT_TEMPERATURE=0.1
