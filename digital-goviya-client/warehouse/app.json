{
  "expo": {
    "name": "Paddy Warehouse",
    "slug": "paddy-warehouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#16A34A"
    },
    "scheme": "paddywarehouse",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nerandadilhara.paddy-warehouse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16A34A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCfNslBQ-Q_czbhuPrr0oqmbMPbGZmoARc"
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
