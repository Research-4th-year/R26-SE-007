# Copy to .env on the server, fill in, and keep out of git.
#   cp .env.production.example .env && nano .env
#
# Generate each secret separately:
#   openssl rand -base64 48

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=warehouse

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# Origins allowed to call the API. The mobile client sends no Origin header,
# so this matters for the gateway and any browser-based component.
ALLOWED_ORIGINS=https://digital-goviya.duckdns.org

# Phase 1: false — backend runs without the ledger, anchoring is skipped.
# Phase 3: true — after the Fabric network is up and fabric-wallet/ is
# populated, at which point set the FABRIC_* paths below to real values.
#
# NOTE: src/config/env.ts currently reads `!== 'true'`, which inverts this
# flag. Fix it to `!== 'false'` before relying on this setting.
FABRIC_ENABLED=false

# Only needed once FABRIC_ENABLED=true; compose supplies defaults otherwise.
FABRIC_PEER_ENDPOINT=
FABRIC_PEER_HOST_ALIAS=
FABRIC_CHANNEL_NAME=warehousechannel
FABRIC_CHAINCODE_NAME=warehousecc
FABRIC_MSP_ID=Org1MSP
FABRIC_CERT_PATH=
FABRIC_KEY_PATH=
FABRIC_TLS_CERT_PATH=
